# GEMINI_API_KEY: Required for Gemini AI (explanations, assistant chat, document extraction).
# Server-side only — never expose this to the browser.
# Matching still works without this key (deterministic RAG fallback).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model override. Default: gemini-2.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# PORT: HTTP port. Bind is 0.0.0.0:$PORT for container / Render deploys.
PORT="3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
